# Configuration Supabase requise pour le déploiement Vercel
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# URL publique de l'application (pour les callbacks d'authentification et redirections)
# En production Vercel : https://votre-projet.vercel.app ou votre domaine personnalisé
# En développement local : http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optionnel : solution de repli, utilisée seulement si NEXT_PUBLIC_APP_URL est vide
# NEXT_PUBLIC_SITE_URL=https://votre-projet.vercel.app

# Configuration Cloudinary (Serveur uniquement)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Nom du compte Cloudinary côté navigateur (public) : même valeur que CLOUDINARY_CLOUD_NAME.
# Sans cette variable, un identifiant Cloudinary brut n'est pas converti en URL d'image
# dans les composants clients (bannières et catégories du flux).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# ---------------------------------------------------------------------------
# Scripts de maintenance et de test (scripts/*.mjs) — NE PAS mettre dans Vercel
# Ces variables se définissent dans le terminal, jamais dans un fichier commité.
# Les scripts qui écrivent refusent le projet de production (scripts/_supabase-env.mjs).
# ---------------------------------------------------------------------------
# RADIZA_SCRIPT_SUPABASE_URL=http://127.0.0.1:54321
# RADIZA_SCRIPT_SUPABASE_ANON_KEY=your-local-or-staging-anon-key
# RADIZA_SCRIPT_ADMIN_EMAIL=admin-de-test@example.com
# RADIZA_SCRIPT_ADMIN_PASSWORD=mot-de-passe-de-test
# RADIZA_SCRIPT_RESELLER_EMAIL=revendeur-de-test@example.com
# RADIZA_SCRIPT_COMPANY_EMAIL=societe-de-test@example.com
# RADIZA_ALLOW_PRODUCTION_READ=oui   # lecture seule sur la production, à confirmer explicitement
