# Configuration Supabase requise pour le déploiement Vercel
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# URL publique de l'application (pour les callbacks d'authentification et redirections)
# En production Vercel : https://votre-projet.vercel.app ou votre domaine personnalisé
# En développement local : http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Configuration Cloudinary (Serveur uniquement)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
